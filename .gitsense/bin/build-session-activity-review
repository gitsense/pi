#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const ANALYZER_ID = "session-activity-review";
const BUILDER_VERSION = "12";
const DEFAULT_BRAIN_NAME = "activity-review";
const FIELD_NAME = "signals";
const FIELD_REPORT = "report";
const FIELD_HANDOFF = "handoff";
const FIELD_REVIEW_CONTEXT = {
  label: "Review signals",
  blurb: "Observable signals extracted from this Pi session.",
  item_singular: "review signal",
  item_plural: "review signals",
};
const FIELD_REPORT_CONTEXT = {
  label: "Session report",
  blurb: "A compact view of the observable activity in this Pi session.",
  item_singular: "session report",
  item_plural: "session reports",
};
const FIELD_HANDOFF_CONTEXT = {
  label: "Pattern review handoff",
  blurb: "A bounded Markdown package for asking another AI to review session patterns.",
  item_singular: "pattern review handoff",
  item_plural: "pattern review handoffs",
};
const SESSION_REVIEW_CONTEXT = {
  label: "Activity review",
  blurb: "Observable signals from this Pi session.",
};
const HANDOFF_MAX_CHARS = 40_000;
const SESSION_FILE_PATH = "__gsc_session__";
const DEFAULT_LOCK_TIMEOUT_MS = 30_000;
const STALE_LOCK_AGE_MS = 10 * 60 * 1000;

function main() {
  try {
    const args = process.argv.slice(2);
    if (args.includes("--help") || args.includes("-h")) {
      printProtocolHelp();
      return;
    }
    if (args.includes("--self-test")) {
      runSelfTest();
      return;
    }
    if (args.length > 0) {
      throw new Error("normal analyzer execution reads one JSON request from stdin; use --help or --self-test");
    }

    const request = readAnalyzerRequest();
    const cacheKey = analyzerCacheKey(request);
    const cachePaths = analyzerCachePaths(cacheKey);
    const releaseLock = acquireLock(cachePaths.lockPath);
    try {
      const cached = readJSON(cachePaths.responsePath);
      if (cached && cached.status && cached.session_id === request.session.session_id) {
        process.stdout.write(`${JSON.stringify({ ...cached, status: "cached" })}\n`);
        return;
      }

      const exportData = runRequestedExport(request);
      const analysis = buildSessionAnalysis(exportData);
      const response = buildAnalyzerResponse(request, analysis);
      writeState(cachePaths.responsePath, response);
      process.stdout.write(`${JSON.stringify(response)}\n`);
    } finally {
      releaseLock();
    }
  } catch (error) {
    process.stderr.write(`[${ANALYZER_ID}] ${error.message}\n`);
    process.exitCode = 1;
  }
}

function printProtocolHelp() {
  process.stdout.write("Read one Session Analyzer Protocol JSON request from stdin and return Markdown tabs.\n\n");
  process.stdout.write("Normal usage:\n");
  process.stdout.write("  gsc pi sessions analyzers run --analyzer activity-review < request.json\n\n");
  process.stdout.write("The request supplies a normalized session descriptor and a gsc export command.\n");
  process.stdout.write("Use --self-test to run deterministic parser checks.\n");
}

function readAnalyzerRequest() {
  const input = fs.readFileSync(0, "utf8");
  let request;
  try {
    request = JSON.parse(input);
  } catch (error) {
    throw new Error(`invalid analyzer request JSON: ${error.message}`);
  }
  if (!request || typeof request !== "object" || Array.isArray(request)) {
    throw new Error("analyzer request must be a JSON object");
  }
  if (request.protocol_version !== "1.0") {
    throw new Error(`unsupported analyzer protocol version ${JSON.stringify(request.protocol_version)}`);
  }
  if (!request.session || typeof request.session.session_id !== "string" || !request.session.session_id) {
    throw new Error("analyzer request session.session_id is required");
  }
  if (!request.export || typeof request.export.executable !== "string" || !request.export.executable) {
    throw new Error("analyzer request export.executable is required");
  }
  if (!Array.isArray(request.export.args) || request.export.args.some((value) => typeof value !== "string")) {
    throw new Error("analyzer request export.args must be an array of strings");
  }
  if (request.requested_tabs != null && (!Array.isArray(request.requested_tabs) || request.requested_tabs.some((value) => typeof value !== "string"))) {
    throw new Error("analyzer request requested_tabs must be an array of strings");
  }
  return request;
}

function analyzerCacheKey(request) {
  const identity = {
    builder: ANALYZER_ID,
    builder_version: BUILDER_VERSION,
    session: request.session,
    range: request.range || {},
    export: request.export,
    requested_tabs: request.requested_tabs || [],
  };
  return createHash("sha256").update(JSON.stringify(identity)).digest("hex");
}

function analyzerCachePaths(cacheKey) {
  const gscHome = process.env.GSC_HOME;
  const root = gscHome
    ? path.join(gscHome, "data", "pi", "session-analyzers", "cache", ANALYZER_ID)
    : path.join(os.tmpdir(), "gsc-session-analyzers", ANALYZER_ID);
  return {
    responsePath: path.join(root, `${cacheKey}.json`),
    lockPath: path.join(root, `${cacheKey}.lock`),
  };
}

function runRequestedExport(request) {
  const result = spawnSync(
    request.export.executable,
    request.export.args,
    { encoding: "utf8", maxBuffer: 128 * 1024 * 1024, shell: false },
  );
  if (result.error) {
    throw new Error(`could not run gsc export: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`gsc export failed: ${result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`}`);
  }
  let data;
  try {
    data = JSON.parse(result.stdout);
  } catch (error) {
    throw new Error(`gsc export returned invalid JSON: ${error.message}`);
  }
  if (data.status !== "success") {
    throw new Error(data.message || `gsc export returned status ${data.status || "unknown"}`);
  }
  return data;
}

function buildAnalyzerResponse(request, analysis) {
  const response = {
    protocol_version: "1.0",
    status: "success",
    analyzer: { id: ANALYZER_ID, version: BUILDER_VERSION },
    session_id: request.session.session_id,
    range: { ...(request.range || {}), revision: request.session.revision || request.range?.revision || "" },
    presentation: {
      label: SESSION_REVIEW_CONTEXT.label,
      blurb: SESSION_REVIEW_CONTEXT.blurb,
    },
    tabs: [
      {
        id: "report",
        label: "Overview",
        default: true,
        markdown: analysis.report.long_markdown,
        copy_label: "Copy overview",
      },
      {
        id: "signals",
        label: "Activity",
        markdown: buildSignalsMarkdown(analysis.records),
        copy_label: "Copy activity",
      },
      {
        id: "handoff",
        label: "Handoff",
        markdown: analysis.handoff.markdown,
        copy_label: "Copy handoff",
      },
    ],
  };
  if (request.requested_tabs?.length) {
    const requested = new Set(request.requested_tabs);
    response.tabs = response.tabs.filter((tab) => requested.has(tab.id));
    if (!response.tabs.length) throw new Error("requested tabs did not match this analyzer");
    response.tabs.forEach((tab, index) => { tab.default = index === 0; });
  }
  return response;
}

function buildSignalsMarkdown(records) {
  const lines = ["# Activity", "", `${records.length} observable signal${records.length === 1 ? "" : "s"}.`, ""];
  for (const record of records) {
    lines.push(`## ${record.title}`, "", record.long_markdown || record.short_markdown || "", "");
  }
  return lines.join("\n").trim() + "\n";
}

function legacyMain() {
  try {
    const flags = parseFlags(process.argv.slice(2));
    if (flags.help) {
      printHelp();
      return;
    }
    if (flags.selfTest) {
      runSelfTest();
      return;
    }
    if (!flags.session) {
      throw new Error("--session is required");
    }
    const brain = validateBrainName(flags.brain);

    const revision = flags.revision || getSessionRevision(flags.session, flags.gsc);
    let releaseLock = null;
    try {
      if (flags.import) {
        const paths = sessionStatePaths(flags.session, brain);
        releaseLock = acquireLock(paths.lockPath, flags.lockTimeoutMs);
        if (isCurrent(paths, revision)) {
          process.stdout.write(`${JSON.stringify({
            status: "unchanged",
            session: flags.session,
            brain,
            revision,
          })}\n`);
          return;
        }
      }

      const exportData = exportSession(flags.session, flags.gsc);
      const analysis = buildSessionAnalysis(exportData);
      const manifest = buildManifest(flags.session, exportData, analysis.records, analysis.report, analysis.handoff, brain);
      const outputPath = path.resolve(
        flags.output || path.join(os.tmpdir(), `gsc-pi-${brain}-${flags.session}.json`),
      );
      fs.writeFileSync(outputPath, `${JSON.stringify(manifest, null, 2)}\n`, { mode: 0o600 });

      process.stderr.write(`[${ANALYZER_ID}] Session: ${flags.session}\n`);
      process.stderr.write(`[${ANALYZER_ID}] Revision: ${revision}\n`);
      process.stderr.write(`[${ANALYZER_ID}] Generated ${analysis.records.length} metadata item(s)\n`);
      process.stderr.write(`[${ANALYZER_ID}] Manifest: ${outputPath}\n`);

      if (!flags.import) {
        process.stderr.write(`[${ANALYZER_ID}] Review the manifest, then rerun with --import\n`);
        return;
      }

      const result = importSessionBrain(flags.session, outputPath, flags.gsc, brain);
      writeState(sessionStatePaths(flags.session, brain).statePath, {
        schema_version: "1.0",
        builder: ANALYZER_ID,
        builder_version: BUILDER_VERSION,
        session: flags.session,
        brain,
        revision,
        processed_at: new Date().toISOString(),
      });
      const payload = parseJSON(result.stdout);
      if (payload) {
        process.stdout.write(`${JSON.stringify({ ...payload, status: "updated", revision })}\n`);
      } else if (result.stdout.trim()) {
        process.stdout.write(result.stdout.trimEnd() + "\n");
      } else {
        process.stdout.write(`${JSON.stringify({ status: "updated", session: flags.session, brain, revision })}\n`);
      }
    } finally {
      if (releaseLock) releaseLock();
    }
  } catch (error) {
    process.stderr.write(`[${ANALYZER_ID}] ${error.message}\n`);
    process.exitCode = 1;
  }
}

function parseFlags(args) {
  const flags = {
    session: "",
    brain: DEFAULT_BRAIN_NAME,
    revision: "",
    output: "",
    gsc: "gsc",
    import: false,
    lockTimeoutMs: DEFAULT_LOCK_TIMEOUT_MS,
    help: false,
    selfTest: false,
  };

  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    switch (arg) {
      case "--session":
      case "--brain":
      case "--revision":
      case "--output":
      case "--gsc": {
        const value = args[index + 1];
        if (!value || value.startsWith("--")) {
          throw new Error(`${arg} requires a value`);
        }
        flags[arg.slice(2)] = value;
        index += 1;
        break;
      }
      case "--lock-timeout-ms": {
        const value = args[index + 1];
        if (!value || value.startsWith("--")) {
          throw new Error(`${arg} requires a value`);
        }
        const timeout = Number(value);
        if (!Number.isInteger(timeout) || timeout < 0 || timeout > 300_000) {
          throw new Error("--lock-timeout-ms must be an integer from 0 to 300000");
        }
        flags.lockTimeoutMs = timeout;
        index += 1;
        break;
      }
      case "--import":
        flags.import = true;
        break;
      case "--self-test":
        flags.selfTest = true;
        break;
      case "--help":
      case "-h":
        flags.help = true;
        break;
      default:
        throw new Error(`Unknown argument: ${arg}`);
    }
  }
  return flags;
}

function printHelp() {
  process.stdout.write("Build deterministic session metadata from a Pi session export.\n\n");
  process.stdout.write("Usage:\n");
  process.stdout.write("  .gitsense/bin/build-session-activity-review --session <uuid> [flags]\n\n");
  process.stdout.write("Flags:\n");
  process.stdout.write("  --session <uuid>   Pi session UUID\n");
  process.stdout.write("  --brain <name>     Session Brain name (default activity-review)\n");
  process.stdout.write("  --revision <value> Current gsc session revision (skips unchanged builds)\n");
  process.stdout.write("  --output <path>    Manifest path (default: system temp directory)\n");
  process.stdout.write("  --import           Replace the session activity-review Brain\n");
  process.stdout.write("  --gsc <path>       gsc executable (default: gsc)\n");
  process.stdout.write("  --lock-timeout-ms  Lock wait timeout (default 30000)\n");
  process.stdout.write("  --self-test        Run deterministic parser checks\n");
  process.stdout.write("  -h, --help         Show this help\n");
}

function getSessionRevision(session, gsc) {
  const result = spawnSync(
    gsc,
    ["pi", "sessions", "revision", "--uuid", session],
    { encoding: "utf8", maxBuffer: 2 * 1024 * 1024 },
  );
  if (result.error) {
    throw new Error(`could not run gsc revision: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`gsc revision failed: ${result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`}`);
  }
  const payload = parseJSON(result.stdout);
  if (!payload || payload.status !== "success" || typeof payload.revision !== "string" || !payload.revision) {
    throw new Error(payload?.message || "gsc revision returned an invalid response");
  }
  return payload.revision;
}

function validateBrainName(value) {
  if (typeof value !== "string" || !/^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$/.test(value)) {
    throw new Error("--brain must be a simple Brain name");
  }
  return value;
}

function sessionStatePaths(session, brain) {
  const gscHome = process.env.GSC_HOME;
  if (!gscHome) throw new Error("GSC_HOME is required when using --import");
  const safeSession = String(session).replace(/[^a-zA-Z0-9._-]/g, "_");
  const sessionBrains = path.join(gscHome, "data", "pi", "session-brains");
  return {
    brainPath: path.join(sessionBrains, `${brain}-${safeSession}.db`),
    statePath: path.join(sessionBrains, ".state", `${brain}-${safeSession}.json`),
    lockPath: path.join(sessionBrains, ".locks", `${brain}-${safeSession}.lock`),
  };
}

function isCurrent(paths, revision) {
  if (!fs.existsSync(paths.brainPath) || !fs.existsSync(paths.statePath)) return false;
  const state = readJSON(paths.statePath);
  return state?.builder === ANALYZER_ID &&
    state?.builder_version === BUILDER_VERSION &&
    state?.revision === revision;
}

function acquireLock(lockPath, timeoutMs = DEFAULT_LOCK_TIMEOUT_MS) {
  fs.mkdirSync(path.dirname(lockPath), { recursive: true });
  const started = Date.now();
  while (true) {
    try {
      fs.mkdirSync(lockPath);
      fs.writeFileSync(path.join(lockPath, "owner.json"), JSON.stringify({
        pid: process.pid,
        created_at: new Date().toISOString(),
      }) + "\n", { mode: 0o600 });
      return () => fs.rmSync(lockPath, { recursive: true, force: true });
    } catch (error) {
      if (error.code !== "EEXIST") throw error;
      if (isStaleLock(lockPath)) {
        fs.rmSync(lockPath, { recursive: true, force: true });
        continue;
      }
      if (Date.now() - started >= timeoutMs) {
        throw new Error(`timed out waiting for session Brain lock: ${lockPath}`);
      }
      sleepSync(50);
    }
  }
}

function isStaleLock(lockPath) {
  let stat;
  try {
    stat = fs.statSync(lockPath);
  } catch {
    return false;
  }
  if (Date.now() - stat.mtimeMs < STALE_LOCK_AGE_MS) return false;
  try {
    const owner = readJSON(path.join(lockPath, "owner.json"));
    if (owner?.pid && isProcessAlive(owner.pid)) return false;
  } catch {
    // A stale lock without readable owner information can be reclaimed.
  }
  return true;
}

function isProcessAlive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (error) {
    return error.code === "EPERM";
  }
}

function sleepSync(milliseconds) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, milliseconds);
}

function readJSON(filePath) {
  try {
    return JSON.parse(fs.readFileSync(filePath, "utf8"));
  } catch {
    return null;
  }
}

function parseJSON(value) {
  try {
    return JSON.parse(value);
  } catch {
    return null;
  }
}

function writeState(filePath, state) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  const temporaryPath = `${filePath}.${process.pid}.tmp`;
  fs.writeFileSync(temporaryPath, `${JSON.stringify(state, null, 2)}\n`, { mode: 0o600 });
  fs.renameSync(temporaryPath, filePath);
}

function exportSession(session, gsc) {
  const result = spawnSync(
    gsc,
    [
      "pi",
      "sessions",
      "export",
      "--format",
      "gsc-json",
      "--uuid",
      session,
      "--head-events",
      "0",
      "--tail-events",
      "0",
      "--capsule-mode",
      "compaction-aware",
    ],
    { encoding: "utf8", maxBuffer: 128 * 1024 * 1024 },
  );
  if (result.error) {
    throw new Error(`could not run gsc export: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`gsc export failed: ${result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`}`);
  }
  let data;
  try {
    data = JSON.parse(result.stdout);
  } catch (error) {
    throw new Error(`gsc export returned invalid JSON: ${error.message}`);
  }
  if (data.status !== "success") {
    throw new Error(data.message || "gsc export failed");
  }
  return data;
}

function importSessionBrain(session, manifestPath, gsc, brain) {
  const result = spawnSync(
    gsc,
    [
      "pi",
      "sessions",
      "brains",
      "import",
      "--session",
      session,
      "--brain",
      brain,
      "--manifest",
      manifestPath,
      "--format",
      "json",
    ],
    { encoding: "utf8", maxBuffer: 16 * 1024 * 1024 },
  );
  if (result.error) {
    throw new Error(`could not import session Brain: ${result.error.message}`);
  }
  if (result.status !== 0) {
    throw new Error(`session Brain import failed: ${result.stderr.trim() || result.stdout.trim() || `exit ${result.status}`}`);
  }
  return result;
}

function buildManifest(session, exportData, records, report, handoff, brain) {
  validateFieldDescriptor(FIELD_NAME, FIELD_REVIEW_CONTEXT);
  validateFieldDescriptor(FIELD_REPORT, FIELD_REPORT_CONTEXT);
  validateFieldDescriptor(FIELD_HANDOFF, FIELD_HANDOFF_CONTEXT);
  const pi = exportData.chat?.meta?.pi || {};
  return {
    schema_version: "1.0",
    generated_at: new Date().toISOString(),
    manifest: {
      name: `${brain}-${session}`,
      database_name: brain,
      description: "Deterministic review signals extracted from observable Pi session activity.",
      tags: ["pi", "session", "activity", "review", "deterministic"],
      scope: "session",
      review_context: SESSION_REVIEW_CONTEXT,
      builder: getBuilderPath(),
    },
    repositories: [
      {
        ref: "session",
        name: pi.repo_root || pi.cwd || "Pi session",
      },
    ],
    branches: [
      {
        ref: "session",
        name: pi.session_uuid || session,
      },
    ],
    analyzers: [
      {
        ref: "A0",
        id: ANALYZER_ID,
        name: ANALYZER_ID,
        description: "Extracts deterministic review signals from observable Pi session activity.",
        version: "2.0.0",
      },
    ],
    fields: [
      {
        ref: "F0",
        analyzer_ref: "A0",
        name: FIELD_NAME,
        display_name: "Session activity",
        type: "array",
        description: "Structured review signals derived from observable Pi session activity.",
        review_context: FIELD_REVIEW_CONTEXT,
        presentation: {
          kind: "signals",
          format: "structured",
          tab_label: "Activity",
        },
      },
      {
        ref: "F1",
        analyzer_ref: "A0",
        name: FIELD_REPORT,
        display_name: "Session activity report",
        type: "array",
        description: "One Markdown report generated from observable Pi session activity.",
        review_context: FIELD_REPORT_CONTEXT,
        presentation: {
          kind: "report",
          format: "markdown",
          tab_label: "Overview",
          default: true,
          drilldown_field: FIELD_NAME,
        },
      },
      {
        ref: "F2",
        analyzer_ref: "A0",
        name: FIELD_HANDOFF,
        display_name: "Pattern review handoff",
        type: "array",
        description: "A builder-defined Markdown package for asking another AI to review observable session patterns.",
        review_context: FIELD_HANDOFF_CONTEXT,
        presentation: {
          kind: "handoff",
          format: "markdown",
          tab_label: "Handoff",
          copyable: true,
          copy_label: "Copy handoff",
        },
      },
    ],
    data: [
      {
        repo_ref: "session",
        branch_ref: "session",
        file_path: SESSION_FILE_PATH,
        language: "Session",
        chat_id: 1,
        fields: { F0: records, F1: [report], F2: [handoff] },
      },
    ],
  };
}

function validateFieldDescriptor(fieldName, descriptor) {
  if (!descriptor?.label || !descriptor.blurb || !descriptor.item_singular || !descriptor.item_plural) {
    throw new Error(`structured review field ${fieldName} requires a complete review_context descriptor`);
  }
}

function getBuilderPath() {
  try {
    return fs.realpathSync(process.argv[1]);
  } catch {
    return path.resolve(process.argv[1]);
  }
}

function buildSessionAnalysis(exportData) {
  const events = collectEvents(exportData);
  const tools = events.flatMap((event) => extractTools(event));
  const reads = tools.filter((tool) => tool.name === "read");
  const edits = tools.filter((tool) => tool.name === "edit");
  const writes = tools.filter((tool) => tool.name === "write");
  const fileEdits = [...edits, ...writes];
  const commands = tools.filter((tool) => tool.name === "bash");
  const typescriptSession = isTypeScriptSession(tools);
  const gitRenames = parseGitRenames(commands);
  const records = [];

  records.push(...buildGitRenameRecords(gitRenames));
  const commandRecords = buildCommandRecords(commands, typescriptSession);
  records.push(...commandRecords);

  const readRecord = buildReadCoverageRecord(reads, typescriptSession);
  if (readRecord) records.push(readRecord);

  const orderingRecords = buildReadOrderingRecords(reads, edits);
  records.push(...orderingRecords);

  const verificationRecord = buildVerificationRecord(commands, fileEdits, typescriptSession);
  if (verificationRecord) records.push(verificationRecord);

  const errorRecord = buildErrorRecord(tools);
  if (errorRecord) records.push(errorRecord);

  const timingRecord = buildTimingRecord(events);
  if (timingRecord) records.push(timingRecord);

  const sortedRecords = records.sort((left, right) => left.key.localeCompare(right.key));
  const reportMarkdown = buildSessionReport({ events, tools, reads, edits, writes, commands, gitRenames });
  const handoffMarkdown = buildSessionHandoff({ events, tools, reads, edits, writes, commands, gitRenames, records: sortedRecords });
  return {
    records: sortedRecords,
    report: buildReportItem(reportMarkdown),
    handoff: buildHandoffItem(handoffMarkdown),
  };
}

function buildReportItem(markdown) {
  const summary = markdown.split("\n").find((line) => line.includes("conversation message")) || "Session activity report";
  return {
    group: "Session report",
    key: `${ANALYZER_ID}:report`,
    title: "Session activity report",
    topics: ["session", "activity", "report"],
    short_markdown: summary,
    long_markdown: markdown,
    markdown,
  };
}

function buildHandoffItem(markdown) {
  return {
    group: "Session handoff",
    key: `${ANALYZER_ID}:handoff`,
    title: "Pattern review handoff",
    topics: ["session", "activity", "handoff", "review"],
    markdown,
  };
}

function buildSessionReport({ events, tools, reads, edits, writes, commands, gitRenames = [] }) {
  const conversation = getConversationMessages(events);
  const users = conversation.filter((event) => event.role === "user");
  const assistants = conversation.filter((event) => event.role === "assistant");
  const fileActivity = [...reads, ...edits, ...writes];
  const files = unique(fileActivity.map((tool) => filePath(tool.args.path)));
  const errors = tools.filter((tool) => tool.isError || tool.status !== "success");
  const turnDurations = getTurnDurations(events);
  const averageTurn = turnDurations.length
    ? turnDurations.reduce((sum, value) => sum + value, 0) / turnDurations.length
    : 0;
  const longestTurn = turnDurations.length ? Math.max(...turnDurations) : 0;
  const report = [
    "# Session activity",
    "",
    `${conversation.length} conversation message${conversation.length === 1 ? "" : "s"} · ${users.length} turn${users.length === 1 ? "" : "s"} · ${tools.length} tool call${tools.length === 1 ? "" : "s"} · ${files.length} unique file${files.length === 1 ? "" : "s"} in activity`,
    "",
    "## Observed elapsed activity",
    "",
  ];

  appendObservedActivity(report, "Reads", reads, "read");
  appendObservedActivity(report, "Edits and writes", [...edits, ...writes], "file change");
  appendObservedActivity(report, "Bash commands", commands, "command");
  report.push(
    "",
    "Observed elapsed time includes model processing and pauses between events. It is not tool execution time.",
    "",
    "## Conversation",
    "",
    `- User messages: ${users.length}`,
    `- Assistant messages: ${assistants.length}`,
    `- Average elapsed turn: ${formatDuration(averageTurn)}`,
    `- Longest elapsed turn: ${formatDuration(longestTurn)}`,
  );

  const commandGroups = summarizeCommandGroups(commands);
  if (commandGroups.length) {
    report.push("", "## Commands", "");
    for (const group of commandGroups) {
      report.push(`- ${capitalize(group.category)}: ${group.count} command${group.count === 1 ? "" : "s"}${group.errors ? ` · ${group.errors} reported error${group.errors === 1 ? "" : "s"}` : ""}`);
    }
  }

  if (gitRenames.length) {
    report.push("", "## Git changes", "", `- Renames: ${gitRenames.length}`);
    for (const rename of gitRenames) {
      report.push(`- ${rename.sources.join(", ")} → ${rename.destination}`);
    }
  }

  if (errors.length) {
    report.push(
      "",
      "## Tool results",
      "",
      `- ${errors.length} non-success tool result${errors.length === 1 ? "" : "s"} recorded.`,
    );
  }

  return `${report.join("\n").trim()}\n`;
}

function buildSessionHandoff({ events, tools, reads, edits, writes, commands, gitRenames = [], records }) {
  const conversation = getConversationMessages(events);
  const users = conversation.filter((event) => event.role === "user");
  const fileActivity = [...reads, ...edits, ...writes];
  const files = unique(fileActivity.map((tool) => filePath(tool.args.path)));
  const errors = tools.filter((tool) => tool.isError || tool.status !== "success");
  const verification = commands.filter((command) => ["build", "typecheck", "test", "lint"].includes(classifyCommand(command.args.command || "")));
  const successfulVerification = verification.filter((command) => !command.isError && command.status === "success");
  const repeatedCommands = summarizeRepeatedCommands(commands);
  const repeatedFailures = repeatedCommands.filter((group) => group.items.length >= 3 && group.items.every((item) => item.isError || item.status !== "success"));
  const phases = inferSessionPhases({ reads, fileActivity, commands, errors, gitRenames });
  const turnDurations = getTurnDurations(events);
  const report = [
    "# Pattern review handoff",
    "",
    "This handoff summarizes observable session behavior. It is for reviewing the work pattern, not for deciding whether the code is correct.",
    "",
    "## Task",
    "",
    `- ${truncateText(users[users.length - 1]?.message || "No user request was available.", 900)}`,
    "",
    "## Scale",
    "",
    `- ${conversation.length} conversation messages · ${users.length} turns · ${tools.length} tool calls · ${files.length} unique files in activity`,
    `- Average elapsed turn: ${formatDuration(turnDurations.length ? turnDurations.reduce((sum, value) => sum + value, 0) / turnDurations.length : 0)}`,
    `- Longest elapsed turn: ${formatDuration(turnDurations.length ? Math.max(...turnDurations) : 0)}`,
    "",
    "## Observed pattern",
    "",
    `- Phase sequence: ${phases.join(" → ")}`,
    `- File activity: ${reads.length} reads · ${edits.length} edits · ${writes.length} writes`,
    `- Git changes: ${gitRenames.length} rename${gitRenames.length === 1 ? "" : "s"}`,
    `- Verification commands: ${verification.length} observed · ${successfulVerification.length} reported success`,
    `- Tool result errors: ${errors.length}`,
    "",
    "## Progress signals",
    "",
  ];

  if (successfulVerification.length) {
    report.push("- Verification commands eventually reported success.");
  } else if (verification.length) {
    report.push("- Verification commands were observed, but none reported success.");
  } else {
    report.push("- No recognized build, typecheck, test, or lint command was observed.");
  }
  if (fileActivity.length) report.push(`- File activity continued across ${files.length} unique file${files.length === 1 ? "" : "s"}.`);
  if (gitRenames.length) report.push(`- Git rename activity affected ${unique(gitRenames.flatMap((rename) => [...rename.sources, rename.destination])).length} path${unique(gitRenames.flatMap((rename) => [...rename.sources, rename.destination])).length === 1 ? "" : "s"}.`);
  if (repeatedCommands.length) report.push(`- ${repeatedCommands.length} command pattern${repeatedCommands.length === 1 ? " was" : "s were"} repeated at least twice.`);
  if (!repeatedCommands.length) report.push("- No command pattern was repeated more than once.");

  report.push("", "## Anomalies", "");
  if (errors.length) {
    report.push(`- ${errors.length} non-success tool result${errors.length === 1 ? "" : "s"} were recorded.`);
  } else {
    report.push("- No non-success tool results were recorded.");
  }
  const partialReads = reads.filter((read) => readCoverage(read) === "partial");
  if (partialReads.length) report.push(`- ${partialReads.length} partial read${partialReads.length === 1 ? "" : "s"} were observed across ${unique(partialReads.map((read) => filePath(read.args.path))).length} files.`);
  if (repeatedFailures.length) {
    report.push(`- ${repeatedFailures.length} possible repeated-failure cycle${repeatedFailures.length === 1 ? "" : "s"} need attention.`);
  } else {
    report.push("- No repeated command and error cycle with three or more failed attempts and no intervening file progress was detected.");
  }

  const evidence = buildCommandEvidence(commands, repeatedCommands, 18);
  if (evidence.length) report.push("", "## Command evidence", "", ...evidence);

  report.push(
    "",
    "## Review question",
    "",
    "Review these observable patterns and identify anything unusual, unresolved, or worth checking. Distinguish recovered errors from ongoing failure loops. Do not assume the agent missed context, and do not treat this handoff as proof of code correctness.",
    "",
    "Observed elapsed time includes model processing and pauses between events. Tool status is reported as exported by the session; a numeric exit code may not be available.",
  );

  return limitHandoff(`${report.join("\n").trim()}\n`);
}

function inferSessionPhases({ reads, fileActivity, commands, errors, gitRenames = [] }) {
  const phases = [];
  if (reads.length) phases.push("explore");
  if (fileActivity.some((tool) => tool.name === "edit" || tool.name === "write") || gitRenames.length) phases.push("implement");
  if (errors.length) phases.push("recover");
  if (commands.some((command) => ["build", "typecheck", "test", "lint"].includes(classifyCommand(command.args.command || "")))) phases.push("verify");
  return unique(phases.length ? phases : ["observe"]);
}

function summarizeRepeatedCommands(commands) {
  const groups = new Map();
  for (const command of commands) {
    const raw = String(command.args.command || "").trim();
    if (!raw) continue;
    const fingerprint = raw.toLowerCase().replace(/\s+/g, " ");
    const group = groups.get(fingerprint) || { command: raw, items: [] };
    group.items.push(command);
    groups.set(fingerprint, group);
  }
  return [...groups.values()]
    .filter((group) => group.items.length >= 2)
    .sort((left, right) => right.items.length - left.items.length || left.command.localeCompare(right.command));
}

function buildCommandEvidence(commands, repeatedCommands, limit) {
  const repeated = new Set(repeatedCommands.map((group) => group.command.toLowerCase().replace(/\s+/g, " ")));
  const selected = commands.filter((command) => {
    const raw = String(command.args.command || "").trim();
    const fingerprint = raw.toLowerCase().replace(/\s+/g, " ");
    return command.isError || command.status !== "success" || repeated.has(fingerprint);
  });
  const seen = new Set();
  const evidence = [];
  for (const command of selected) {
    const raw = String(command.args.command || "").trim();
    const fingerprint = raw.toLowerCase().replace(/\s+/g, " ");
    const identity = `${fingerprint}\x00${command.status}\x00${command.isError}`;
    if (seen.has(identity)) continue;
    seen.add(identity);
    const matching = selected.filter((item) => {
      const value = String(item.args.command || "").trim().toLowerCase().replace(/\s+/g, " ");
      return value === fingerprint;
    });
    const statuses = matching.map((item) => formatToolStatus(item)).join(" → ");
    const output = matching.map((item) => getOutputExcerpt(item.resultText)).find(Boolean);
    evidence.push(`### \`${truncateText(raw, 320)}\``, `- Attempts: ${matching.length}`, `- Statuses: ${statuses || "unknown"}`);
    if (output) evidence.push(`- Output excerpt: ${output}`);
    evidence.push("");
    if (evidence.filter((line) => line.startsWith("### ")).length >= limit) break;
  }
  return evidence;
}

function formatToolStatus(tool) {
  if (tool.exitCode !== null && tool.exitCode !== undefined) return `exit ${tool.exitCode}`;
  if (tool.isError) return "error";
  return tool.status || "unknown";
}

function getOutputExcerpt(value, maxLength = 260) {
  if (!value || typeof value !== "string") return "";
  const lines = value.split(/\r?\n/).map((line) => line.trim()).filter(Boolean);
  const relevant = lines.filter((line) => /error|fail|exception|cannot|no such|passed|success/i.test(line));
  const selected = (relevant.length ? relevant.slice(0, 2) : lines.slice(-2)).join(" / ");
  return truncateText(selected.replace(/`/g, "'"), maxLength);
}

function truncateText(value, maxLength) {
  const text = String(value || "").replace(/\s+/g, " ").trim();
  if (text.length <= maxLength) return text;
  return `${text.slice(0, Math.max(0, maxLength - 1)).trimEnd()}…`;
}

function limitHandoff(markdown) {
  if (markdown.length <= HANDOFF_MAX_CHARS) return markdown;
  return `${markdown.slice(0, HANDOFF_MAX_CHARS - 80).trimEnd()}\n\n[Additional routine evidence omitted by the builder to keep this handoff bounded.]\n`;
}

function appendObservedActivity(lines, label, values, singular) {
  if (values.length === 0) return;
  const elapsed = observedElapsed(values);
  lines.push(`- ${label}: ${formatDuration(elapsed)} observed across ${values.length} ${singular}${values.length === 1 ? "" : "s"}`);
}

function getConversationMessages(events) {
  const regular = events
    .filter((event) => event.type === "regular" && (event.role === "user" || event.role === "assistant"))
    .sort((left, right) => new Date(eventTime(left)).getTime() - new Date(eventTime(right)).getTime());
  const users = regular.filter((event) => event.role === "user" && String(event.message || "").trim());
  const messages = [];
  for (let index = 0; index < users.length; index += 1) {
    const user = users[index];
    const start = new Date(eventTime(user)).getTime();
    const nextUser = users[index + 1];
    const boundary = nextUser ? new Date(eventTime(nextUser)).getTime() : null;
    const assistants = regular.filter((event) => {
      const timestamp = new Date(eventTime(event)).getTime();
      return event.role === "assistant" && String(event.message || "").trim() && timestamp >= start && (boundary == null || timestamp < boundary);
    });
    messages.push(user);
    if (assistants.length) messages.push(assistants[assistants.length - 1]);
  }
  return messages;
}

function observedElapsed(values) {
  const timestamps = values
    .map((value) => Date.parse(value.timestamp || ""))
    .filter((value) => Number.isFinite(value));
  if (timestamps.length < 2) return 0;
  return Math.max(...timestamps) - Math.min(...timestamps);
}

function summarizeCommandGroups(commands) {
  const groups = new Map();
  for (const command of commands) {
    const category = classifyCommand(command.args.command || "") || "other";
    const group = groups.get(category) || { category, count: 0, errors: 0 };
    group.count += 1;
    if (command.isError || command.status !== "success") group.errors += 1;
    groups.set(category, group);
  }
  return [...groups.values()].sort((left, right) => left.category.localeCompare(right.category));
}

function collectEvents(exportData) {
  const candidates = [
    ...eventArray(exportData.chat?.head),
    ...eventArray(exportData.chat?.capsule),
    ...eventArray(exportData.chat?.compacted_capsule),
    ...eventArray(exportData.chat?.tail),
  ];
  const seen = new Set();
  return candidates
    .filter((event) => {
      const identity = `${event.type || ""}\x00${event.entry_id || event.id || ""}`;
      if (seen.has(identity)) return false;
      seen.add(identity);
      return true;
    })
    .sort((left, right) => (left.id || 0) - (right.id || 0));
}

function eventArray(value) {
  if (Array.isArray(value)) return value;
  if (value && Array.isArray(value.messages)) return value.messages;
  return [];
}

function extractTools(event) {
  if (event.type !== "pi-tools" || typeof event.message !== "string") return [];
  let payload;
  try {
    payload = JSON.parse(event.message);
  } catch {
    return [];
  }
  return (payload.tools || []).map((tool, index) => ({
    name: tool.tool_name || tool.name || "unknown",
    args: tool.arguments || {},
    status: tool.status || "unknown",
    isError: tool.is_error === true,
    exitCode: tool.exit_code ?? tool.exitCode ?? null,
    resultText: tool.result_text || "",
    eventId: event.id,
    entryId: event.entry_id || "",
    timestamp: event.created_at || event.timestamp || "",
    ordinal: index,
  }));
}

function buildCommandRecords(commands, typescriptSession) {
  const byCategory = new Map();
  for (const command of commands) {
    const category = classifyCommand(command.args.command || "");
    if (!category) continue;
    if (!byCategory.has(category)) byCategory.set(category, new Map());
    const byCommand = byCategory.get(category);
    const display = displayCommand(command.args.command || "");
    const existing = byCommand.get(display) || { count: 0, errors: 0, last: command.timestamp };
    existing.count += 1;
    if (command.isError || command.status !== "success") existing.errors += 1;
    existing.last = command.timestamp || existing.last;
    byCommand.set(display, existing);
  }

  return [...byCategory.entries()].map(([category, byCommand]) => {
    const entries = [...byCommand.entries()].sort((left, right) => left[0].localeCompare(right[0]));
    const total = entries.reduce((sum, [, value]) => sum + value.count, 0);
    const commandText = compactCommandList(entries);
    const errors = entries.reduce((sum, [, value]) => sum + value.errors, 0);
    const title = `${capitalize(category)}: ${commandText} (${total})`;
    const lines = entries.map(([command, value]) => `- \`${command}\` — ${value.count} occurrence${value.count === 1 ? "" : "s"}${value.errors ? `; ${value.errors} reported error${value.errors === 1 ? "" : "s"}` : ""}`);
    return reviewItem(
      `commands:${category}`,
      title,
      `The agent ran ${total} ${category} command${total === 1 ? "" : "s"}.`,
      `### ${capitalize(category)} commands\n\n${lines.join("\n")}\n\nCommand status is based on the exported tool result. Shell pipelines may make the underlying exit status unknown.`,
      [category, "commands", ...(category === "build" || category === "typecheck" || category === "test" ? ["verification"] : []), ...(typescriptSession ? ["typescript"] : [])],
      errors ? ["errors"] : [],
    );
  });
}

function buildGitRenameRecords(renames) {
  const grouped = new Map();
  for (const rename of renames) {
    const identity = `${rename.sources.join("\x00")}\x00${rename.destination}`;
    const group = grouped.get(identity) || {
      sources: rename.sources,
      destination: rename.destination,
      commands: [],
      followUps: [],
      statuses: [],
    };
    group.commands.push(rename.command);
    group.followUps.push(...rename.followUps);
    group.statuses.push(rename.status);
    grouped.set(identity, group);
  }

  return [...grouped.values()].map((rename) => {
    const count = rename.commands.length;
    const sourceText = rename.sources.map((source) => inlineCode(source)).join(", ");
    const destinationText = inlineCode(rename.destination);
    const followUpCount = rename.followUps.length;
    const followUpSummary = summarizeFollowUps(rename.followUps);
    const title = `Git rename: ${rename.sources.join(", ")} → ${rename.destination}${count > 1 ? ` (${count})` : ""}`;
    const short = `Renamed ${sourceText} to ${destinationText} with git mv${followUpSummary ? `, then ran ${followUpSummary}` : ""}.`;
    const lines = [
      "### Git rename",
      ...rename.sources.map((source) => `- From: ${inlineCode(source)}`),
      `- To: ${destinationText}`,
      `- Status: ${unique(rename.statuses).join(", ") || "unknown"}`,
      ...rename.commands.map((command) => `- Command: ${inlineCode(command)}`),
    ];
    if (followUpCount) {
      lines.push("", "### Follow-up commands");
      for (const followUp of rename.followUps) {
        lines.push(`- ${inlineCode(followUp.command)} (${followUp.kind})`);
      }
    }
    return reviewItem(
      `git:rename:${stableKey(`${rename.sources.join("-")}-${rename.destination}`)}`,
      title,
      short,
      lines.join("\n"),
      ["git", "rename", "file-activity"],
      rename.statuses.some((status) => status !== "success") ? ["errors"] : [],
      "Git changes",
    );
  });
}

function summarizeFollowUps(followUps) {
  const counts = new Map();
  for (const followUp of followUps) {
    counts.set(followUp.kind, (counts.get(followUp.kind) || 0) + 1);
  }
  return [...counts.entries()]
    .map(([kind, count]) => `${count} ${kind}${count === 1 ? "" : "s"}`)
    .join(" and ");
}

function parseGitRenames(commands) {
  const renames = [];
  for (const command of commands) {
    const rawCommand = String(command.args.command || "");
    const segments = splitShellSegments(rawCommand);
    let cwd = "";
    for (let index = 0; index < segments.length; index += 1) {
      const segment = segments[index];
      const tokens = tokenizeShell(segment);
      if (tokens[0] === "cd" && tokens[1]) {
        cwd = resolveActivityPath(tokens[1], cwd);
        continue;
      }
      const parsed = parseGitMv(tokens, cwd);
      if (!parsed) continue;
      const followUps = segments.slice(index + 1)
        .map((followUp) => ({
          command: followUp.trim(),
          kind: classifyGitFollowUp(followUp),
        }))
        .filter((followUp) => followUp.command);
      renames.push({
        ...parsed,
        command: segment.trim(),
        followUps,
        status: command.isError || command.status !== "success" ? (command.status || "error") : "success",
      });
    }
  }
  return renames;
}

function parseGitMv(tokens, cwd) {
  if (!tokens.length) return null;
  let gitIndex = -1;
  for (let index = 0; index < Math.min(tokens.length, 4); index += 1) {
    if (tokens[index] === "git") {
      gitIndex = index;
      break;
    }
  }
  if (gitIndex < 0) return null;

  let index = gitIndex + 1;
  let gitCwd = cwd;
  while (index < tokens.length && tokens[index] !== "mv") {
    if (tokens[index] === "-C" && tokens[index + 1]) {
      gitCwd = resolveActivityPath(tokens[index + 1], cwd);
      index += 2;
      continue;
    }
    if (tokens[index].startsWith("-")) {
      index += 1;
      continue;
    }
    return null;
  }
  if (tokens[index] !== "mv") return null;

  const operands = [];
  let endOptions = false;
  for (index += 1; index < tokens.length; index += 1) {
    const token = tokens[index];
    if (!endOptions && token === "--") {
      endOptions = true;
      continue;
    }
    if (!endOptions && token.startsWith("-")) continue;
    operands.push(token);
  }
  if (operands.length < 2) return null;

  const destination = resolveActivityPath(operands.at(-1), gitCwd);
  const sources = operands.slice(0, -1).map((source) => resolveActivityPath(source, gitCwd));
  if (!destination || sources.some((source) => !source)) return null;
  return { sources, destination };
}

function classifyGitFollowUp(command) {
  const value = command.toLowerCase();
  if (/\b(sed|perl)\b/.test(value)) return "edit";
  if (/\b(grep|rg|git\s+(diff|status))\b/.test(value)) return "verification";
  return "follow-up";
}

function splitShellSegments(command) {
  const segments = [];
  let start = 0;
  let quote = "";
  let escaped = false;
  for (let index = 0; index < command.length; index += 1) {
    const character = command[index];
    if (escaped) {
      escaped = false;
      continue;
    }
    if (character === "\\" && quote !== "'") {
      escaped = true;
      continue;
    }
    if (quote) {
      if (character === quote) quote = "";
      continue;
    }
    if (character === "'" || character === '"') {
      quote = character;
      continue;
    }
    const isDoubleOperator = (character === "&" && command[index + 1] === "&")
      || (character === "|" && command[index + 1] === "|");
    if (character === ";" || character === "|" || isDoubleOperator) {
      const segment = command.slice(start, index).trim();
      if (segment) segments.push(segment);
      if (isDoubleOperator) index += 1;
      start = index + 1;
    }
  }
  const finalSegment = command.slice(start).trim();
  if (finalSegment) segments.push(finalSegment);
  return segments;
}

function tokenizeShell(command) {
  const tokens = [];
  let token = "";
  let quote = "";
  let escaped = false;
  const push = () => {
    if (token) tokens.push(token);
    token = "";
  };
  for (const character of command) {
    if (escaped) {
      token += character;
      escaped = false;
      continue;
    }
    if (character === "\\" && quote !== "'") {
      escaped = true;
      continue;
    }
    if (quote) {
      if (character === quote) quote = "";
      else token += character;
      continue;
    }
    if (character === "'" || character === '"') {
      quote = character;
    } else if (/\s/.test(character)) {
      push();
    } else {
      token += character;
    }
  }
  if (escaped) token += "\\";
  push();
  return tokens;
}

function resolveActivityPath(value, cwd) {
  if (!value) return "";
  if (path.isAbsolute(value)) return path.normalize(value);
  return cwd ? path.normalize(path.resolve(cwd, value)) : path.normalize(value);
}

function stableKey(value) {
  return String(value).replace(/[^a-z0-9._-]+/gi, "-").replace(/^-+|-+$/g, "").slice(0, 180) || "rename";
}

function inlineCode(value) {
  return `\`${String(value).replaceAll("`", "'")}\``;
}

function buildReadCoverageRecord(reads, typescriptSession) {
  if (reads.length === 0) return null;
  const partial = reads.filter((read) => readCoverage(read) === "partial");
  const full = reads.filter((read) => readCoverage(read) === "full");
  const unknown = reads.filter((read) => readCoverage(read) === "unknown");
  const partialFiles = unique(reads.filter((read) => readCoverage(read) === "partial").map((read) => filePath(read.args.path)));
  const fullFiles = unique(reads.filter((read) => readCoverage(read) === "full").map((read) => filePath(read.args.path)));
  const title = `Reads: ${partial.length} partial reads across ${partialFiles.length} files`;
  const lines = [
    `- Partial reads: ${partial.length} across ${partialFiles.length} files`,
    `- Reads without a visible truncation marker: ${full.length} across ${fullFiles.length} files`,
  ];
  if (unknown.length) lines.push(`- Unknown coverage: ${unknown.length} reads`);
  if (partialFiles.length) lines.push(`- Partial files: ${partialFiles.map((value) => `\`${value}\``).join(", ")}`);
  return reviewItem(
    "reads:coverage",
    title,
    `The session returned ${partial.length} partial file read${partial.length === 1 ? "" : "s"}.`,
    `### Read coverage\n\n${lines.join("\n")}\n\nA read is marked partial when the tool supplied a bounded range or the result contained a truncation marker. A read without that evidence is a full candidate, not proof that the agent understood the entire file.`,
    ["reads", "read-coverage", "partial-read", ...(typescriptSession ? ["typescript"] : [])],
  );
}

function buildReadOrderingRecords(reads, edits) {
  const files = new Map();
  for (const read of reads) {
    const key = filePath(read.args.path);
    if (!key) continue;
    if (!files.has(key)) files.set(key, { reads: [], edits: [] });
    files.get(key).reads.push(read);
  }
  for (const edit of edits) {
    const key = filePath(edit.args.path);
    if (!key) continue;
    if (!files.has(key)) files.set(key, { reads: [], edits: [] });
    files.get(key).edits.push(edit);
  }

  const partialBeforeEdit = [];
  const withoutRead = [];
  for (const [file, activity] of files.entries()) {
    if (activity.edits.length === 0) continue;
    const firstEdit = activity.edits[0].eventId;
    const readsBeforeEdit = activity.reads.filter((read) => read.eventId < firstEdit);
    if (readsBeforeEdit.length === 0) {
      withoutRead.push(file);
      continue;
    }
    if (readsBeforeEdit.every((read) => readCoverage(read) === "partial")) partialBeforeEdit.push(file);
  }

  const records = [];
  if (partialBeforeEdit.length) {
    records.push(reviewItem(
      "read-order:partial-before-edit",
      `Partial reads before edit (${partialBeforeEdit.length} files)`,
      `${partialBeforeEdit.length} edited files were only partially read before their first edit.`,
      `### Partial reads before edit\n\n${partialBeforeEdit.map((file) => `- \`${file}\``).join("\n")}\n\nThis is an observable ordering signal. It does not prove that the agent missed information required for the edit.`,
      ["read-coverage", "partial-read", "read-before-edit", "review"],
    ));
  }
  if (withoutRead.length) {
    records.push(reviewItem(
      "read-order:edited-without-read",
      `Edited without prior read (${withoutRead.length} ${withoutRead.length === 1 ? "file" : "files"})`,
      `${withoutRead.length} edited files had no preceding read operation in the session.`,
      `### Edited without prior read\n\n${withoutRead.map((file) => `- \`${file}\``).join("\n")}\n\nThis is an observable session signal, not a conclusion about the agent's prior knowledge.`,
      ["read-coverage", "read-before-edit", "review"],
    ));
  }
  return records;
}

function buildVerificationRecord(commands, edits, typescriptSession) {
  if (edits.length === 0) return null;
  const verification = commands.filter((command) => ["build", "typecheck", "test", "lint"].includes(classifyCommand(command.args.command || "")));
  if (verification.length === 0) {
    return reviewItem(
      "verification:after-final-edit",
      "Verification after final edit: None observed",
      "No build, typecheck, test, or lint command was observed after the edits.",
      "### Verification\n\nNo recognized build, typecheck, test, or lint command was observed in this session.",
      ["verification", "review", ...(typescriptSession ? ["typescript"] : [])],
    );
  }
  const lastEdit = latestTimestamp(edits);
  const lastVerification = latestTimestamp(verification);
  const verifiedAfterEdit = lastVerification && lastEdit && lastVerification >= lastEdit;
  const state = verifiedAfterEdit ? "Yes" : "No";
  return reviewItem(
    "verification:after-final-edit",
    `Verification after final edit: ${state}`,
    verifiedAfterEdit ? "A recognized verification command ran after the final edit." : "The final edit occurred after the last recognized verification command.",
    `### Verification after final edit\n\n- Last edit: ${lastEdit || "unknown"}\n- Last verification command: ${lastVerification || "unknown"}\n- Verification after final edit: **${state}**\n\nRecognized verification includes build, typecheck, test, and lint commands.`,
    ["verification", "review", ...(typescriptSession ? ["typescript"] : [])],
  );
}

function buildErrorRecord(tools) {
  const errors = tools.filter((tool) => tool.isError || tool.status !== "success");
  if (errors.length === 0) return null;
  const lines = errors.slice(0, 20).map((tool) => `- ${tool.name}${tool.args.command ? `: \`${displayCommand(tool.args.command)}\`` : ""}`);
  return reviewItem(
    "errors:tool-results",
    `Errors: ${errors.length}`,
    `The session contains ${errors.length} tool result error${errors.length === 1 ? "" : "s"}.`,
    `### Tool result errors\n\n${lines.join("\n")}${errors.length > 20 ? "\n- Additional errors are present in the session export." : ""}`,
    ["errors", "review"],
  );
}

function isTypeScriptSession(tools) {
  return tools.some((tool) => {
    const candidate = tool.args.path || tool.args.command || "";
    return /\.(cts|mts|ts|tsx)\b/i.test(candidate) || /\b(npm|pnpm|yarn|bun|tsc|tsx|ts-node)\b/i.test(candidate);
  });
}

function buildTimingRecord(events) {
  const turns = getTurnDurations(events);
  if (turns.length === 0) return null;
  const average = turns.reduce((sum, value) => sum + value, 0) / turns.length;
  const longest = Math.max(...turns);
  return reviewItem(
    "timing:turns",
    `Elapsed: ${turns.length} turn${turns.length === 1 ? "" : "s"} · avg ${formatDuration(average)} · longest ${formatDuration(longest)}`,
    `The session contains ${turns.length} user turn${turns.length === 1 ? "" : "s"}; the average observed elapsed turn was ${formatDuration(average)}.`,
    `### Observed elapsed turn time\n\n- Turns: ${turns.length}\n- Average: ${formatDuration(average)}\n- Longest: ${formatDuration(longest)}\n\nObserved elapsed time is measured from each user message to the last assistant message before the next user message. It includes model processing and pauses between events, not just tool execution.`,
    ["timing", "elapsed", "review"],
  );
}

function getTurnDurations(events) {
  const regular = events
    .filter((event) => event.type === "regular" && (event.role === "user" || event.role === "assistant"))
    .sort((left, right) => new Date(eventTime(left)).getTime() - new Date(eventTime(right)).getTime());
  const users = regular.filter((event) => event.role === "user");
  return users.map((user, index) => {
    const start = new Date(eventTime(user)).getTime();
    const nextUser = users[index + 1];
    const boundary = nextUser ? new Date(eventTime(nextUser)).getTime() : null;
    const assistants = regular.filter((event) => {
      const timestamp = new Date(eventTime(event)).getTime();
      return event.role === "assistant" && timestamp >= start && (boundary == null || timestamp < boundary);
    });
    const end = assistants.length ? new Date(eventTime(assistants[assistants.length - 1])).getTime() : (boundary || start);
    return Math.max(0, end - start);
  });
}

function reviewItem(key, title, shortMarkdown, longMarkdown, topics = [], keywords = [], group = "Session activity") {
  return {
    group,
    key: `${ANALYZER_ID}:${key}`,
    title,
    topics: unique(topics),
    keywords: unique(keywords),
    short_markdown: shortMarkdown,
    long_markdown: longMarkdown,
    markdown: longMarkdown,
  };
}

function classifyCommand(command) {
  const value = command.toLowerCase();
  if (/(^|[;&|])\s*(npm|pnpm|yarn|bun)\s+(run\s+)?(build|compile)\b/.test(value) || /\b(tsc)\b.*\s(-b|--build)\b/.test(value) || /\b(cargo|go|make)\s+build\b/.test(value)) return "build";
  if (/(^|[;&|])\s*(npm|pnpm|yarn|bun)\s+(run\s+)?(check|typecheck)\b/.test(value) || /\btsc\b.*(--noEmit|--no-emit|--pretty)\b/.test(value)) return "typecheck";
  if (/(^|[;&|])\s*(npm|pnpm|yarn|bun)\s+(run\s+)?test\b/.test(value) || /\b(vitest|jest|pytest)\b/.test(value) || /\bnode\s+--test\b/.test(value) || /\b(cargo|go)\s+test\b/.test(value)) return "test";
  if (/(^|[;&|])\s*(npm|pnpm|yarn|bun)\s+(run\s+)?lint\b/.test(value) || /\b(eslint|biome|prettier)\b/.test(value)) return "lint";
  if (/\b(node|tsx|ts-node)\b/.test(value) || /\b(npm|pnpm|yarn|bun)\s+(run\s+)?(start|dev)\b/.test(value)) return "runtime";
  return "";
}

function displayCommand(command) {
  const segments = command.split(/&&|\|\||[;|]/).map((segment) => segment.trim()).filter(Boolean);
  const interesting = segments.find((segment) => classifyCommand(segment));
  return (interesting || command)
    .replace(/\s+2>&1\b/g, "")
    .replace(/\s+2>\s*[^\s]+/g, "")
    .trim();
}

function compactCommandList(entries) {
  const commands = entries.map(([command]) => command);
  const maxLength = 150;
  const visible = [];
  let length = 0;
  for (const command of commands) {
    const addition = visible.length === 0 ? command : `, ${command}`;
    if (length + addition.length > maxLength && visible.length > 0) break;
    visible.push(command);
    length += addition.length;
  }
  const hidden = commands.length - visible.length;
  return visible.join(", ") + (hidden > 0 ? `, +${hidden} more` : "");
}

function readCoverage(read) {
  if (read.resultText.includes("more lines in file") || read.args.limit != null || Number(read.args.offset || 0) !== 0) return "partial";
  if (read.resultText.length > 0 && !read.isError && read.status === "success") return "full";
  return "unknown";
}

function filePath(value) {
  if (!value || typeof value !== "string") return "";
  return path.isAbsolute(value) ? path.normalize(value) : path.normalize(value);
}

function latestTimestamp(values) {
  return values.map((value) => value.timestamp || "").filter(Boolean).sort().at(-1) || "";
}

function eventTime(event) {
  return event.created_at || event.timestamp || new Date(0).toISOString();
}

function formatDuration(milliseconds) {
  const seconds = Math.round(milliseconds / 1000);
  if (seconds < 60) return `${seconds}s`;
  const minutes = Math.floor(seconds / 60);
  const remainingSeconds = seconds % 60;
  if (minutes < 60) return `${minutes}m ${remainingSeconds}s`;
  const hours = Math.floor(minutes / 60);
  return `${hours}h ${minutes % 60}m`;
}

function unique(values) {
  return [...new Set(values.filter(Boolean))];
}

function capitalize(value) {
  return value.charAt(0).toUpperCase() + value.slice(1);
}

function runSelfTest() {
  validateFieldDescriptor(FIELD_NAME, FIELD_REVIEW_CONTEXT);
  validateFieldDescriptor(FIELD_REPORT, FIELD_REPORT_CONTEXT);
  assert(FIELD_REVIEW_CONTEXT.item_plural === "review signals", "session field descriptor");
  const sampleEvents = [
    { type: "regular", role: "user", message: "first", created_at: "2026-01-01T00:00:00.000Z" },
    { type: "regular", role: "assistant", message: "", created_at: "2026-01-01T00:00:01.000Z" },
    { type: "regular", role: "assistant", message: "first response", created_at: "2026-01-01T00:00:02.000Z" },
    { type: "regular", role: "user", message: "second", created_at: "2026-01-01T00:01:00.000Z" },
    { type: "regular", role: "assistant", message: "second response", created_at: "2026-01-01T00:01:03.000Z" },
  ];
  assert(getConversationMessages(sampleEvents).length === 4, "conversation message classifier");
  assert(buildSessionReport({ events: sampleEvents, tools: [], reads: [], edits: [], writes: [], commands: [] }).includes("4 conversation messages"), "report conversation count");
  const sampleHandoff = buildHandoffItem(buildSessionHandoff({ events: sampleEvents, tools: [], reads: [], edits: [], writes: [], commands: [], records: [] }));
  assert(typeof sampleHandoff.markdown === "string" && !Object.hasOwn(sampleHandoff, "short_markdown"), "handoff markdown contract");
  assert(sampleHandoff.markdown.length <= HANDOFF_MAX_CHARS, "handoff size bound");
  assert(classifyCommand("cd /repo && npm run build") === "build", "build classification");
  assert(classifyCommand("npm run check") === "typecheck", "typecheck classification");
  assert(classifyCommand("npm test") === "test", "test classification");
  assert(readCoverage({ args: { limit: 100 }, resultText: "", status: "success", isError: false }) === "partial", "bounded read classification");
  assert(readCoverage({ args: {}, resultText: "[10 more lines in file]", status: "success", isError: false }) === "partial", "marker read classification");
  assert(displayCommand("cd /repo && npm run build 2>&1 | tail -20") === "npm run build", "command display");
  const renameCommand = {
    args: { command: "cd /repo/components && git mv OtherSessionsView.js AllSessionsView.js && sed -i '' 's/pi-other-sessions/pi-all-sessions/g' AllSessionsView.js && grep -n 'pi-other-sessions' AllSessionsView.js" },
    status: "success",
    isError: false,
  };
  const renames = parseGitRenames([renameCommand]);
  assert(renames.length === 1, "git mv detection");
  assert(renames[0].sources[0] === "/repo/components/OtherSessionsView.js", "git mv source path");
  assert(renames[0].destination === "/repo/components/AllSessionsView.js", "git mv destination path");
  assert(renames[0].followUps.length === 2 && renames[0].followUps[0].kind === "edit" && renames[0].followUps[1].kind === "verification", "git mv follow-up classification");
  assert(buildGitRenameRecords(renames)[0].group === "Git changes", "git rename review group");
  process.stdout.write("session-activity-review self-test passed\n");
}

function assert(condition, message) {
  if (!condition) throw new Error(`self-test failed: ${message}`);
}

main();
